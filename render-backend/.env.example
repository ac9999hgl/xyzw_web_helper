# ===== Supabase 数据库（必填，缺 SUPABASE_URL 后端会启动即崩溃）=====
# Supabase 项目地址，形如 https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase service_role key（后台服务密钥，不是 anon key）
# 在 Supabase Dashboard -> Project Settings -> API 中复制
SUPABASE_KEY=

# ===== 后端接口共享密钥（必填，自定义一串随机字符串）=====
# Coze / 其他调用方请求 /api/** 时需在请求头携带：
#   x-api-key: <本值>   或   Authorization: Bearer <本值>
API_KEY=

# ===== 端口（本地调试可填 3000；Render 上由平台自动注入，留空即可）=====
PORT=3000
